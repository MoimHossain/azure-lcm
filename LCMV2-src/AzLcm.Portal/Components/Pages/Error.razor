@page "/Error"
@using System.Diagnostics

<PageTitle>Error — Azure Lifecycle Sentinel</PageTitle>

<FluentCard Style="padding: 32px; max-width: 600px; margin: 40px auto; text-align: center;">
    <FluentIcon Value="@(new Icons.Regular.Size48.ErrorCircle())" Color="Color.Error" />
    <FluentLabel Typo="Typography.PageTitle" Style="margin: 16px 0 8px;">Something went wrong</FluentLabel>
    <FluentLabel Typo="Typography.Body" Color="Color.Lightweight">
        An error occurred while processing your request.
    </FluentLabel>

    @if (ShowRequestId)
    {
        <FluentLabel Typo="Typography.Body" Style="margin-top: 12px;">
            <strong>Request ID:</strong> <code>@RequestId</code>
        </FluentLabel>
    }

    <FluentAnchor Href="/" Appearance="Appearance.Accent" Style="margin-top: 24px;">
        Return to Dashboard
    </FluentAnchor>
</FluentCard>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
