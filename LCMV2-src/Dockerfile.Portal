FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["AzLcm.Portal/AzLcm.Portal.csproj", "AzLcm.Portal/"]
COPY ["AzLcm.Shared/AzLcm.Shared.csproj", "AzLcm.Shared/"]
RUN dotnet restore "AzLcm.Portal/AzLcm.Portal.csproj"
COPY . .
WORKDIR "/src/AzLcm.Portal"
RUN dotnet build "AzLcm.Portal.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "AzLcm.Portal.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "AzLcm.Portal.dll"]
